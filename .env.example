# lx-hub 环境变量模板
# 用法：复制本文件为 .env（cp .env.example .env），Docker Compose 会自动读取，
#       覆盖 docker-compose.yml 里的 ${VAR:-默认值}，无需改动 compose 文件本身。

# ---- 后台账户（务必修改密码） ----
LXH_ADMIN_USER=admin
LXH_ADMIN_PASS=admin888

# ---- 监听端口 / 地址（一般无需修改；改端口时同步修改 compose 的端口映射） ----
# LXHUB_PORT=58059
# LXHUB_HOST=0.0.0.0

# ---- 时区（定时任务按此时区触发） ----
# TZ=Asia/Shanghai
